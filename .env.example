# Copie para .env (na raiz do projeto) e ajuste. Um único .env serve aos dois serviços.

# ─── Serviço de service desk simulado (services/service-desk) ───────────────
# Porta HTTP do "sistema legado" de chamados.
SERVICE_DESK_PORT=4010

# Chave compartilhada entre o app e o serviço (mínimo 16 caracteres).
# Troque por um valor aleatório em qualquer ambiente fora da sua máquina.
SERVICE_DESK_API_KEY=troque-esta-chave-local

# Banco SQLite do serviço (caminho relativo à pasta services/service-desk).
SERVICE_DESK_DATABASE_URL=file:data/service-desk.db

# Instabilidade simulada do sistema legado (o PRD diz que ele "fica indisponível
# por alguns segundos"). Coloque CHAOS_FAILURE_RATE=0 para desligar.
#   CHAOS_FAILURE_RATE: chance (0 a 1) de cada requisição iniciar uma queda
#   CHAOS_OUTAGE_MS:    duração de cada queda, em ms
#   CHAOS_LATENCY_MS:   latência máxima adicionada a cada requisição, em ms
CHAOS_FAILURE_RATE=0.05
CHAOS_OUTAGE_MS=4000
CHAOS_LATENCY_MS=150

# ─── App web (apps/web) ─────────────────────────────────────────────────────
# Onde o app encontra o serviço de chamados.
SERVICE_DESK_URL=http://localhost:4010

# Banco do app: sessões, conversas e mensagens (relativo à pasta apps/web).
APP_DATABASE_URL=file:data/app.db

# ─── IA: agent com Mastra ───────────────────────────────────────────────────
# Provedor principal e plano B. Se o principal falhar (cota, fora do ar), o agent
# usa o plano B; se os dois falharem ou não houver chave, responde em modo básico
# (regras, sem IA).
#   Valores: google | groq | none
LLM_PROVIDER=google
LLM_FALLBACK_PROVIDER=groq

# Modelos (opcional). Os padrões têm plano gratuito e suportam ferramentas.
LLM_GOOGLE_MODEL=gemini-flash-lite-latest
LLM_GROQ_MODEL=openai/gpt-oss-120b

# Chave grátis em https://aistudio.google.com (menu "Get API key").
GOOGLE_GENERATIVE_AI_API_KEY=

# Chave grátis em https://console.groq.com (menu "API Keys").
GROQ_API_KEY=
