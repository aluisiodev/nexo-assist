{
  "name": "@nexo/service-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serviço de chamados e central de ajuda simulados (o 'sistema legado' da Nexo), separado do agent.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "@nexo/domain": "*",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nexo/service-desk-client": "*"
  }
}
